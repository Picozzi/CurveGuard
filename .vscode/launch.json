{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CurveGuard Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build CurveGuard.Web",
      "program": "${workspaceFolder}/CurveGuard.Web/bin/Debug/net10.0/CurveGuard.Web.dll",
      "cwd": "${workspaceFolder}/CurveGuard.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5186"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Replay",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build CurveGuard",
      "program": "${workspaceFolder}/bin/Debug/net10.0/CurveGuard.dll",
      "cwd": "${workspaceFolder}",
      "args": ["REPLAY=ALL"]
    },
    {
      "name": "Live",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build CurveGuard",
      "program": "${workspaceFolder}/bin/Debug/net10.0/CurveGuard.dll",
      "cwd": "${workspaceFolder}",
      "args": []
    }
  ]
}
