@page "/"
@inject RunWorkspace Workspace
<PageTitle>Live Runs · CurveGuard</PageTitle>

<div class="section-intro">
    <div class="kicker"><span></span>Curve Validation</div>
    <h1>Live Runs</h1>
    <p>Build and validate the USD SOFR curve for a market date.</p>
</div>
<div class="workspace-grid">
    <CurvePanel Report="report" Source="@source" />
    <section class="control-card">
        <div class="control-title"><span class="control-symbol" aria-hidden="true">▦</span><h2>Run Configuration</h2></div>
        <div class="control-body">
            <label for="market-date">Valuation Date</label>
            <input type="date" id="market-date" required @bind="date" disabled="@busy" />
            <button class="primary" disabled="@(busy || date is null)" @onclick="Run"><i class="play" aria-hidden="true"></i>@(busy ? "Running Curve…" : "Run Live Curve")</button>
            <p class="form-note">Fetches market inputs and runs bootstrap and pricing checks.</p>
            <div class="control-foot"><span>Market Inputs</span><strong>SOFR · EFFR · OIS · ZQ</strong></div>
        </div>
    </section>
</div>
@if (error is not null) { <p class="error" role="alert">@error</p> }
@if (busy) { <p class="progress" role="status">Running Live Validation For @date?.ToString("yyyy-MM-dd")…</p> }
@if (report is not null) { <ReportDetails Report="report" /> }
@if (history.Count > 0)
{
    <section class="history">
        <h2>Saved Live Runs</h2>
        <div class="history-links">
            @foreach (var item in history)
            {
                <button disabled="@busy" @onclick="() => Open(item)">@item.Name</button>
            }
        </div>
    </section>
}

@code {
    private DateOnly? date = new DateOnly(2026, 11, 19);
    private RunReport? report;
    private List<SavedReport> history = [];
    private string source = "";
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        history = Workspace.LiveHistory();
        var initial = history.FirstOrDefault() ?? Workspace.FindReplay("clean");
        if (initial is not null) await Open(initial);
    }

    private async Task Open(SavedReport saved)
    {
        busy = true;
        error = null;
        try
        {
            report = await RunWorkspace.ReadAsync(saved);
            source = saved.Label == "Saved live run" ? saved.Label : saved.Label + " · clean";
            if (saved.Label == "Saved live run") date = report.Inputs.ValuationDate;
        }
        catch (Exception ex) { error = $"Could not open {saved.Name}. {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task Run()
    {
        if (busy || date is not { } selected) return;
        busy = true;
        error = null;
        try
        {
            report = await Workspace.ExecuteAsync(selected, null);
            source = "Live run";
            history = Workspace.LiveHistory();
        }
        catch (Exception ex) { error = $"Live run for {selected:yyyy-MM-dd} could not complete. {ex.Message}"; }
        finally { busy = false; }
    }
}
