@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<header class="masthead">
    <div class="mast-inner">
        <a href="/" class="brand" aria-label="CurveGuard home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>CurveGuard</a>
        <div class="mast-end">
            <span class="market-id">USD / SOFR</span>
            <button class="menu-toggle" aria-label="Navigation menu" aria-expanded="@open.ToString().ToLowerInvariant()" aria-controls="site-menu" @onclick="Toggle" @onkeydown="KeyDown">
                <span class="menu-glyph" aria-hidden="true"><i></i><i></i><i></i></span> Menu
            </button>
        </div>
        @if (open)
        {
            <nav id="site-menu" aria-label="Workspace" @onkeydown="KeyDown">
                <NavLink href="/" Match="NavLinkMatch.All" @onclick="Close">Live runs</NavLink>
                <NavLink href="/replays" @onclick="Close">Replays</NavLink>
            </nav>
        }
    </div>
</header>
<main>@Body</main>
<div id="blazor-error-ui" role="alert">The connection to CurveGuard was interrupted. <a href="">Reload workspace</a></div>

@code {
    private bool open;
    protected override void OnInitialized() => Navigation.LocationChanged += Changed;
    private void Changed(object? sender, LocationChangedEventArgs args) => Close();
    private void Toggle() => open = !open;
    private void Close() => open = false;
    private void KeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") Close(); }
    public void Dispose() => Navigation.LocationChanged -= Changed;
}
