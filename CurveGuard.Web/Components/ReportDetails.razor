<section class="results">
    <div class="results-head" id="guard">
        <h2>Run Summary</h2>
        <span class="decision @(Report.Validation.Decision == "PASS" ? "pass" : "quarantine")">@Report.Validation.Decision</span>
    </div>
    <div class="metrics">
        <div><span>SOFR Fixing</span><strong>@Report.Inputs.SofrFixing.RatePercent.ToString("0.00")<small>%</small></strong></div>
        <div><span>EFFR Fixing</span><strong>@EffrRate<small>%</small></strong></div>
        <div><span>OIS Quotes</span><strong>@Report.Inputs.OisSnapshot.Quotes.Count</strong></div>
        <div><span>Bootstrap</span><strong class="status-text">@Report.BootstrapStatus</strong></div>
    </div>
    @if (Report.Validation.ValidationRisks is { Count: > 0 } findings)
    {
        <h3>Input findings</h3>
        @for (int i = 0; i < findings.Count; i++)
        {
            var check = findings[i];
            <div class="finding" id="@($"input-{i+1}")"><strong>@check.Code</strong><p>@check.Message</p>
            <span>@check.Tenor @check.Contract @if (check.QuoteDate is { } observed) { <text>Observed @observed.ToString("yyyy-MM-dd") </text> } @if (check.ExpectedDate is { } expected) { <text>Expected @expected.ToString("yyyy-MM-dd")</text> }</span></div>
        }
    }
    else if (Report.Validation.PricingRisks is not { Count: > 0 } && !string.IsNullOrWhiteSpace(Report.Validation.Message))
    {
        <p class="finding">@Report.Validation.Message</p>
    }
    @if (Report.Validation.PricingRisks is { Count: > 0 } risks)
    {
        <h3>Pricing Checks</h3>
        <div class="table-scroll"><table><thead><tr><th>Check</th><th>Bump</th><th>Actual</th><th>Expected</th><th>Result</th></tr></thead>
            <tbody>@for (int i = 0; i < risks.Count; i++)
            {
                var r = risks[i];
                <tr id="@($"pricing-{i+1}")"><th>@r.Code.Replace('_',' ')</th><td>@(r.BumpBp.HasValue ? $"{r.BumpBp} bp" : "—")</td><td>@Format(r.Actual)</td><td>@Format(r.Expected)</td><td class="@(r.Passed ? "ok" : "fail")">@(r.Passed ? "Pass" : "Fail")</td></tr>
            }</tbody></table></div>
    }
    @if (Report.Diagnostic is { } diagnostic)
    {
        <section class="diagnosis"><h3>Diagnostic</h3><p>@diagnostic.Explanation</p><strong>Next action</strong><p>@diagnostic.RecommendedNextAction</p>
        @if (diagnostic.Unknowns is { Count: > 0 }) { <strong>Unknowns</strong><p>@string.Join(" ",diagnostic.Unknowns)</p> }
        <div class="citations">@foreach (var id in diagnostic.EvidenceIds)
        {
            <a href="@($"{Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]}#{id}")">@id</a>
        }</div></section>
    }
    else if (!string.IsNullOrEmpty(Report.DiagnosticError)) { <p class="finding">Diagnostic unavailable. @Report.DiagnosticError</p> }
</section>

@code {
    [Parameter, EditorRequired] public RunReport Report { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private string EffrRate => Report.Inputs.EffrFixing.Rate.ToString(
        Math.Abs(Report.Inputs.EffrFixing.Rate) >= 1000 ? "0.##E+0" : "0.00", CultureInfo.InvariantCulture);
    private static string Format(double? value) => value switch
    {
        null => "—",
        > -.005 and < .005 => "0.00",
        _ => value.Value.ToString("N2", CultureInfo.InvariantCulture)
    };
}
